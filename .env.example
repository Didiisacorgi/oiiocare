# Server-only. Never expose these in front-end code.
# Leave OIIO_AI_API_KEY empty to run the persona mock (guest /chat still works).
# Production text provider is DeepSeek (set on the Vercel project oiiocare-web):

OIIO_AI_API_KEY=
OIIO_AI_BASE_URL=https://api.deepseek.com/v1
OIIO_AI_MODEL=deepseek-chat

# Photo reads go to DashScope (qwen-vl-plus), the same family as the iOS app.
# DeepSeek cannot read images. Leave the vision key empty to keep the
# in-chat "照片收到了" fallback and skip the vision call.

OIIO_VISION_API_KEY=
OIIO_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OIIO_VISION_MODEL=qwen-vl-plus

# Optional. The browser already ships the public anon key in js/public-config.js.
# Do not put the service role key anywhere in this repo.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
